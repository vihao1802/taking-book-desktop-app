{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ESNext", "DOM", "DOM.Iterable"],
    "skipLibCheck": true,
    "esModuleInterop": true,
    "strict": true,
    "noImplicitAny": true,
    "jsx": "react-jsx",
    "baseUrl": ".",
    "paths": { "@/*": ["../renderer/src/*"] },
    "noEmit": true
  },
  "include": ["src", "browser-check/harness.ts", "browser-check/harness-reader-api.ts", "capacitor.config.ts"]
}
