{
  "name": "@taking-book/desktop",
  "productName": "taking-book-desktop-app",
  "version": "1.4.2",
  "description": "Electron desktop app for Taking Book.",
  "main": ".vite/build/main.js",
  "private": true,
  "scripts": {
    "start": "npm run build --workspace @taking-book/core && npm run generate:icons && electron-forge start",
    "generate:icons": "node scripts/generate-icons.mjs",
    "package": "npm run build --workspace @taking-book/core && npm run generate:icons && electron-forge package",
    "make": "npm run build --workspace @taking-book/core && npm run generate:icons && electron-forge make",
    "publish": "electron-forge publish",
    "lint": "eslint --ext .ts,.tsx .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "keywords": [],
  "author": {
    "name": "Vi Hao",
    "email": "tranvihao40@gmail.com"
  },
  "license": "MIT",
  "dependencies": {
    "@taking-book/core": "0.1.0",
    "better-sqlite3": "^13.0.2",
    "dotenv": "^17.4.2",
    "electron-squirrel-startup": "^1.0.1",
    "google-translate-api-x": "^10.7.3",
    "pdfjs-dist": "^6.2.108",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@electron-forge/cli": "^7.11.2",
    "@electron-forge/maker-deb": "^7.11.2",
    "@electron-forge/maker-rpm": "^7.11.2",
    "@electron-forge/maker-squirrel": "^7.11.2",
    "@electron-forge/maker-zip": "^7.11.2",
    "@electron-forge/plugin-auto-unpack-natives": "^7.11.2",
    "@electron-forge/plugin-fuses": "^7.11.2",
    "@electron-forge/plugin-vite": "^7.11.2",
    "@electron/fuses": "^1.8.0",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-label": "^2.1.15",
    "@radix-ui/react-progress": "^1.1.16",
    "@radix-ui/react-select": "^2.3.7",
    "@radix-ui/react-separator": "^1.1.15",
    "@radix-ui/react-slider": "^1.4.7",
    "@radix-ui/react-slot": "^1.3.3",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/better-sqlite3": "^9.6.0",
    "@types/electron-squirrel-startup": "^1.0.2",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "@vitejs/plugin-react": "^4.7.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "electron": "43.2.0",
    "eslint": "^8.57.1",
    "eslint-import-resolver-typescript": "^3.6.3",
    "eslint-plugin-import": "^2.32.0",
    "icon-gen": "^4.0.0",
    "lucide-react": "^1.31.0",
    "sharp": "^0.32.6",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.9.3",
    "vite": "^5.4.21",
    "vitest": "^3.2.7"
  }
}
