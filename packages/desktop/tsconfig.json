{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "lib": ["ESNext", "DOM", "DOM.Iterable"],
    "allowJs": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "strict": true,
    "noImplicitAny": true,
    "sourceMap": true,
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/renderer/*"]
    },
    "resolveJsonModule": true,
    "noEmit": true
  },
  "include": ["src", "forge.config.ts", "forge.env.d.ts", "vite.main.config.ts", "vite.preload.config.ts", "vite.renderer.config.ts"]
}
